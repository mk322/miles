# Machine-specific settings for examples/ota_sft. Copy to <your_site>.env, fill in, then
#   set -a; source examples/ota_sft/site/<your_site>.env; set +a
# before running anything in examples/ota_sft. Code reads only these variables; it hardcodes no path.
# Never put WANDB_API_KEY in this file (it is committed); export it in your shell instead.

# Root of everything large. Layout (created by the steps in collab/ handover docs):
#   $OTA_ROOT/models/Qwen3-8B                                 HF base model
#   $OTA_ROOT/datasets/OpenThoughts-Agent-SFT-10K             HF dataset snapshot
#   $OTA_ROOT/datasets/ota_sft_10k_aligned.jsonl              prepare_data_aligned.py output
#   $OTA_ROOT/datasets/{swebench-verified-random-100-folders,terminal_bench_2}   eval tasks
#   $OTA_ROOT/venvs/harbor                                    Harbor venv (editable install of HARBOR_SRC)
#   $OTA_ROOT/runs/<run_id>/{checkpoints,hf/step_<N>}         training output (mounted as /root/shared_data)
#   $OTA_ROOT/eval_jobs, $OTA_ROOT/logs                       Harbor jobs and queue logs
OTA_ROOT=__FILL_ME__

# Harbor checkout on branch datagen-parity (github.com/mk322/harbor).
HARBOR_SRC=__FILL_ME__

# Training image: docker/Dockerfile.sm80 built on top of radixark/miles:v0.1.3 (see docker_train.py).
MILES_IMAGE=miles-ota:v0.1.3-sm80
